# Public app identifier from the Privy dashboard. Never put the app secret here.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public, owner-reviewed enrollment identities, pinned at web build time.
# Leave empty to disable new chat-trading enrollment.
NEXT_PUBLIC_MCP_SIGNER_QUORUM_ID=
NEXT_PUBLIC_MCP_SIGNER_POLICY_ID=
# Must point to the Nest API, including /api. Its proxy must allow streaming.
NEXT_PUBLIC_OREN_API_URL=http://localhost:3000/api
# Solana RPC credentials belong in the API environment; trades use server-side signing.

NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_PREVIEW_PR_NUMBER=
NEXT_PUBLIC_COMMIT_SHA=

# Local development only: show unpublished changelog entries. Ignored in production.
OREN_CHANGELOG_PREVIEW=0
