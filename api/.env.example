# Server
PORT=3000
# Comma-separated browser origins allowed to call the API, e.g. https://oren.finance.
# `*` (or unset) allows any origin outside production only. In production `*`/unset
# falls back to MCP_APP_ORIGIN, then https://$DOMAIN, with a startup warning, and the
# API refuses to start if neither is set. Set it explicitly in production.
CORS_ORIGIN=*

# Postgres (Oren application memory)
POSTGRES_URL=postgresql://user:password@localhost:5432/oren

# Tokens.xyz Assets API v1
# Docs: https://docs.tokens.xyz/v1/quickstart
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=

# Alchemy Solana
ALCHEMY_API_KEY=
SOLANA_NETWORK=mainnet
# Optional WebSocket override; otherwise derived from ALCHEMY_API_KEY.
# Keep this server-side. Deposits currently support mainnet only.
ALCHEMY_SOLANA_WS_URL=

# Privy authentication (required for funding and user-authorized server trade signing)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# MCP OAuth connection. Keep disabled until the migration, DNS/TLS, and OTP
# acceptance test are complete. This exposes read tools and browser-approved
# buy intents; delegated signing requires an isolated Privy policy proof.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=https://api.oren.finance/oauth
MCP_APP_ORIGIN=https://oren.finance
# Stable random 32+ byte base64 key; do not rotate while tokens/grants are live.
MCP_OAUTH_STORAGE_KEY=
# Two or more independent random cookie signing keys, comma separated.
MCP_OAUTH_COOKIE_KEYS=
# JSON JWKS containing at least one private signing JWK. Keep server-side only.
MCP_OAUTH_JWKS=

# Headless MCP trading stays off until a disposable-wallet Privy route-policy
# proof and owner-only rollout. PR previews reject enabling it.
MCP_DELEGATED_TRADES_ENABLED=false
MCP_DELEGATED_BUYS_ENABLED=false
MCP_DELEGATED_SELLS_ENABLED=false
# Explicit Privy user DIDs, comma separated. A wildcard is rejected.
MCP_DELEGATED_TRADES_ALLOWED_USERS=
# Opens enrollment to every signed-in user instead of the allowlist above.
# Wallet-signed grants and the dollar, slippage and expiry limits still apply.
# Set together with SIGNER_GATE_PUBLIC on the signer gate.
MCP_DELEGATED_TRADES_PUBLIC=false
# Match the reviewed browser/gate policy; older grants prompt re-enrollment.
PRIVY_MCP_SIGNER_POLICY_ID=
MCP_DELEGATED_MAX_PER_TRADE_USD=25
MCP_DELEGATED_MAX_DAILY_USD=50
PRIVY_MCP_SIGNER_QUORUM_ID=
# API quorum key only. Use a separate configuration for the second quorum key.
PRIVY_MCP_SIGNER_PRIVATE_KEY=
PRIVY_POLICY_ADMIN_QUORUM_ID=
SIGNER_GATE_URL=http://signer-gate:3001
SIGNER_GATE_API_TOKEN=

# Jupiter (swap quotes/builds + Trigger limit orders). lite-api.jup.ag is retired;
# leave the URLs empty to use https://api.jup.ag/swap/v1 and /trigger/v1.
JUPITER_API_URL=
# Optional override; defaults to same host as JUPITER_API_URL with /trigger/v1
JUPITER_TRIGGER_API_URL=
# Optional public key included by Jupiter for Dune/platform attribution.
JUPITER_TRACKING_ACCOUNT=
# Jupiter Developer Platform key (sent as x-api-key, only to *.jup.ag). Keyless = 0.5 rps, free key = 1 rps.
# Strongly recommended in production.
JUPITER_API_KEY=
# Optional client-side request budget shared by quote/swap/trigger calls (requests per second).
# Defaults to 1 with JUPITER_API_KEY, 0.5 without. Split it across API replicas.
# Half of the window is reserved for user quotes/swaps; the limit-order poller can only use the rest.
JUPITER_MAX_RPS=

# Titan swap routing (server-only). Unset TITAN_API_KEY = Titan disabled (kill switch).
TITAN_API_KEY=
# Optional; defaults to https://portal.api.titan.exchange
TITAN_API_URL=
# Optional client-side budget in requests per second (default 1 = Sandbox plan). Titan is skipped, not queued, when spent.
# A third of the window is reserved for re-quotes at prepare time; quotes/shadow/auto-refresh use the rest.
TITAN_MAX_RPS=
# Optional comma-separated extra program ids allowed in Titan-built transactions (built-in allowlist covers
# Titan swap, ComputeBudget, SPL Token/Token-2022, ATA and Memo). Routes using other programs fall back to Jupiter.
TITAN_EXTRA_PROGRAM_IDS=
# Optional max deviation from Titan's reference price, in bps (default 100 = 1%; Titan's own default is 1000).
# Larger trades with >1% price impact get no Titan route and use Jupiter. Titan skips the check when it has no reference price.
TITAN_MAX_PRICE_DEVIATION_BPS=
# jupiter (default) | shadow (quote both, log, execute Jupiter) | best (execute the better quote net of fees)
SWAP_ROUTER_MODE=

# Optional public verification pipeline. Trading and in-app volume work without it.
DUNE_API_KEY=
DUNE_API_BASE_URL=https://api.dune.com/api/v1
DUNE_UPLOAD_NAMESPACE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=

# Drip writer and podcast opinions for the in-app agent (server-only).
# Docs: https://docs.dripstack.com/v2
# Off unless both flags are true and the caller has a verified Privy user and linked wallet.
# Keep the flags off in production until the signed-in app rollout is accepted.
DRIP_ENABLED=
DRIP_PUBLIC_RESEARCH_ENABLED=
DRIP_API_KEY=
DRIP_API_BASE_URL=
DRIP_REQUEST_TIMEOUT_MS=

# Senviok transactional email
SENVIOK_API_KEY=
SENVIOK_FROM=

# Bitget Reality public market data (no API key required)
BITGET_API_BASE_URL=https://api.bitget.com
# All independent Bitget calls run in parallel, so this is a total per-call ceiling rather than cumulative latency.
BITGET_REQUEST_TIMEOUT_MS=8000

# Oren timelock program
VAULT_PROGRAM_ID=4yBSLwXvYQhHExDuvuuEsaHfUC392SdRSiM8r6m832Mj
# Flip to true only after the vault program is deployed and IDL-verified.
# While false, prepare/confirm lock+unlock return 503 (VAULT_PROGRAM_NOT_LIVE).
VAULT_PROGRAM_LIVE=false

# Deployment metadata; preview disables execution and background workers.
DEPLOYMENT_ENV=development
# Mailbox the operator monitors. Required before production EDGAR fetches.
# Unset disables SEC company facts. Previews never fetch, even if this is set.
# SEC_CONTACT_EMAIL=
# Required for preview only:
PREVIEW_PR_NUMBER=
COMMIT_SHA=
